  "components": [
    {
      "name": "Основная кнопка",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Основное действие. Цвета наследуют light/dark через brand и on-brand.",
      "html": "<button class=\"ds-primary\" type=\"button\">Сохранить</button>",
      "css": ".ds-primary{font-family:var(--font-sans,Manrope,system-ui,sans-serif);font-size:13px;font-weight:650;min-height:40px;padding:9px 16px;border:1px solid var(--brand,#161b30);border-radius:9px;background:var(--brand,#161b30);color:var(--on-brand,#fff);cursor:pointer;transition:background-color .2s,color .2s,border-color .2s,transform .2s cubic-bezier(.16,1,.3,1)}.ds-primary:hover:not(:disabled){background:var(--accent,#2a45cc);border-color:var(--accent,#2a45cc);color:#fff}.ds-primary:active:not(:disabled){transform:translateY(1px)}.ds-primary:disabled{opacity:.45;cursor:not-allowed}.ds-primary:focus-visible,.ds-ghost:focus-visible{outline:2px solid var(--accent,#2a45cc);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-ghost,.ds-kpi,.ds-appearance,.ds-upload{transition:none;animation:none}}"
    },
    {
      "name": "Вторичная кнопка",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Дополнительное действие на спокойной поверхности.",
      "html": "<button class=\"ds-ghost\" type=\"button\">Отмена</button>",
      "css": ".ds-ghost{font-family:var(--font-sans,Manrope,system-ui,sans-serif);font-size:13px;font-weight:500;min-height:40px;padding:9px 14px;border:1px solid var(--line-strong,#161b3029);border-radius:9px;background:var(--surface,#fff);color:var(--ink,#161b30);cursor:pointer;transition:background-color .2s,color .2s,border-color .2s,transform .2s cubic-bezier(.16,1,.3,1)}.ds-ghost:hover:not(:disabled){background:var(--surface-2,#f2f4f7);border-color:var(--ink-mute,#676d84);color:var(--ink,#161b30)}.ds-ghost:active:not(:disabled){transform:translateY(1px)}.ds-ghost:disabled{opacity:.45;cursor:not-allowed}.ds-primary:focus-visible,.ds-ghost:focus-visible{outline:2px solid var(--accent,#2a45cc);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-ghost,.ds-kpi,.ds-appearance,.ds-upload{transition:none;animation:none}}"
    },
    {
      "name": "Поле",
      "kind": "input",
      "refersTo": "input",
      "description": "Общее редактируемое поле; readonly-профиль использует surface-2.",
      "html": "<label class=\"ds-label\" for=\"ds-shop\">Название магазина</label><input class=\"ds-input\" id=\"ds-shop\" placeholder=\"Название\">",
      "css": ".ds-label{display:block;margin-bottom:5px;font-family:var(--font-sans,Manrope,system-ui,sans-serif);font-size:12.5px;font-weight:600;color:var(--ink-soft,#4b5168)}.ds-input{font-family:var(--font-sans,Manrope,system-ui,sans-serif);font-size:14px;min-height:40px;padding:10px 12px;background:var(--surface,#fff);color:var(--ink,#161b30);border:1px solid var(--line-strong,#161b3029);border-radius:9px;caret-color:var(--accent,#2a45cc)}.ds-input::placeholder{color:var(--ink-mute,#676d84);opacity:1}.ds-input:focus{border-color:var(--accent,#2a45cc);box-shadow:0 0 0 3px var(--accent-soft,#e4e9fb);outline:0}.ds-input:focus-visible{outline:2px solid var(--accent,#2a45cc);outline-offset:3px}.ds-input[readonly]{background:var(--surface-2,#f2f4f7);color:var(--ink-soft,#4b5168)}@media(max-width:600px){.ds-input{font-size:16px}}"
    },
    {
      "name": "Активная навигация",
      "kind": "nav",
      "refersTo": "nav",
      "description": "Полоса навигации; разметка содержит встроенную существующую SVG-иконку.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Рабочее пространство\"><a class=\"ds-nav-link\" href=\"#overview\" aria-current=\"page\"><svg class=\"ds-nav-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"4\" y=\"4\" width=\"6\" height=\"6\" rx=\"1.5\"/><rect x=\"14\" y=\"4\" width=\"6\" height=\"6\" rx=\"1.5\"/><rect x=\"4\" y=\"14\" width=\"6\" height=\"6\" rx=\"1.5\"/><rect x=\"14\" y=\"14\" width=\"6\" height=\"6\" rx=\"1.5\"/></svg>Обзор</a></nav>",
      "css": ".ds-nav{background:var(--page,#dfe4f4);padding:14px;width:236px}.ds-nav-link{font-family:var(--font-sans,Manrope,system-ui,sans-serif);font-size:14px;font-weight:550;display:flex;align-items:center;gap:11px;min-height:42px;padding:5px 10px;border:1px solid transparent;border-radius:12px;color:var(--ink-soft,#4b5168);text-decoration:none}.ds-nav-link:hover{background:color-mix(in srgb,var(--surface,#fff) 45%,transparent);color:var(--ink,#161b30)}.ds-nav-link[aria-current=page]{background:color-mix(in srgb,var(--surface,#fff) 62%,transparent);border-color:color-mix(in srgb,var(--accent,#2a45cc) 22%,transparent);color:var(--ink,#161b30);font-weight:700}.ds-nav-icon{width:28px;height:28px;padding:6px;border-radius:8px;fill:none;stroke:currentColor;stroke-width:1.7;background:var(--accent,#2a45cc);color:#fff;flex:none}.ds-nav-link:focus-visible{outline:2px solid var(--accent,#2a45cc);outline-offset:3px}"
    },
    {
      "name": "Благоприятная дельта",
      "kind": "chip",
      "refersTo": "chip-up",
      "description": "Смысл изменения задаётся метрикой; статичный образец без вымышленной суммы.",
      "html": "<span class=\"ds-chip\"><svg class=\"ds-chip-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m5 15 6-6 4 4 5-7M15 6h5v5\"/></svg>Рост прибыли</span>",
      "css": ".ds-chip{font-family:var(--font-sans,Manrope,system-ui,sans-serif);display:inline-flex;align-items:center;gap:4px;padding:2px 6px;border-radius:5px;background:var(--good-bg,#e0efe9);color:var(--good,#2b7a64);font-size:11px;line-height:1.5;font-weight:600}.ds-chip-icon{width:12px;height:12px;fill:none;stroke:currentColor;stroke-width:1.8}@media(max-width:600px){.ds-chip{font-size:12px;padding:2px 4px}}"
    },
    {
      "name": "Карточка настроек",
      "kind": "card",
      "refersTo": "card",
      "description": "Плоская поверхность с отступом 20 px, без декоративного подъёма.",
      "html": "<section class=\"ds-card\"><strong class=\"ds-card-title\">Публичная витрина</strong><p class=\"ds-card-copy\">Ссылка на магазин в режиме просмотра</p></section>",
      "css": ".ds-card{font-family:var(--font-sans,Manrope,system-ui,sans-serif);padding:20px;border:1px solid var(--line-strong,#161b3029);border-radius:16px;background:var(--surface,#fff);color:var(--ink,#161b30);box-shadow:none}.ds-card-title{font-size:16px;font-weight:700}.ds-card-copy{font-size:12px;line-height:1.6;color:var(--ink-mute,#676d84)}@media(max-width:600px){.ds-card{padding:16px}}"
    },
    {
      "name": "Выбранный KPI",
      "kind": "button",
      "refersTo": "kpi-selected",
      "description": "Ячейка связанной панели. Прочерк сохраняет смысл неизвестного значения; preview не подключает график.",
      "html": "<button class=\"ds-kpi\" type=\"button\" aria-pressed=\"true\"><span class=\"ds-kpi-label\">Сумма продаж</span><span class=\"ds-kpi-value\">—</span><span class=\"ds-kpi-action\">Смотреть динамику</span></button>",
      "css": ".ds-kpi{font-family:var(--font-sans,Manrope,system-ui,sans-serif);display:flex;flex-direction:column;text-align:left;min-height:184px;padding:18px 20px 16px;border:1px solid var(--line,#161b3017);border-radius:0;background:var(--surface,#fff);color:var(--ink,#161b30);cursor:pointer;transition:background-color .2s}.ds-kpi:hover{background:var(--surface-2,#f2f4f7)}.ds-kpi:focus-visible{outline:2px solid var(--accent,#2a45cc);outline-offset:3px}.ds-kpi-label{font-size:13px;color:var(--ink-soft,#4b5168);margin-bottom:16px}.ds-kpi-value{font-size:26px;font-weight:750;font-variant-numeric:tabular-nums;white-space:nowrap}.ds-kpi-action{margin-top:auto;padding-top:12px;border-top:1px dashed var(--line-strong,#161b3029);font-size:12px;color:var(--accent,#2a45cc);text-decoration:underline;text-underline-offset:3px}"
    },
    {
      "name": "Выбор оформления",
      "kind": "button",
      "refersTo": "appearance-selected",
      "description": "Состояние выбора темы; обработчик localStorage остаётся в приложении, preview показывает стили.",
      "html": "<button class=\"ds-appearance\" type=\"button\" aria-pressed=\"true\"><svg class=\"ds-appearance-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z\"/></svg>Тёмная</button>",
      "css": ".ds-appearance{font-family:var(--font-sans,Manrope,system-ui,sans-serif);font-size:14px;display:flex;align-items:center;gap:10px;min-width:130px;padding:14px;border:1px solid var(--line-strong,#161b3029);border-radius:9px;text-align:left;background:var(--surface,#fff);color:var(--ink,#161b30);cursor:pointer;transition:background-color .2s,color .2s,border-color .2s,transform .2s cubic-bezier(.16,1,.3,1)}.ds-appearance[aria-pressed=true]{border-color:var(--accent,#2a45cc);background:var(--accent-soft,#e4e9fb);color:var(--accent,#2a45cc)}.ds-appearance:active{transform:translateY(1px)}.ds-appearance:focus-visible{outline:2px solid var(--accent,#2a45cc);outline-offset:3px}.ds-appearance-icon{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.6}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-ghost,.ds-kpi,.ds-appearance,.ds-upload{transition:none;animation:none}}"
    },
    {
      "name": "Загрузка отчёта",
      "kind": "custom",
      "description": "Dropzone с тематическим наведением. Preview не загружает файл.",
      "html": "<div class=\"ds-upload\" role=\"button\" tabindex=\"0\" aria-label=\"Загрузить отчёт\"><strong>Отчёт маркетплейса</strong><p class=\"ds-upload-hint\">Перетащите файл или выберите его</p></div>",
      "css": ".ds-upload{font-family:var(--font-sans,Manrope,system-ui,sans-serif);background:var(--surface,#fff);color:var(--ink,#161b30);border:1px dashed var(--line-strong,#161b3029);border-radius:16px;min-height:210px;padding:25px 20px;text-align:center;cursor:pointer;box-shadow:none}.ds-upload:hover,.ds-upload.ds-dragover{background:var(--accent-soft,#e4e9fb);border-color:var(--accent,#2a45cc);transform:none;box-shadow:none}.ds-upload:focus-visible{outline:2px solid var(--accent,#2a45cc);outline-offset:3px}.ds-upload strong{font-size:14px;font-weight:650}.ds-upload-hint{font-size:12px;line-height:1.65;color:var(--ink-mute,#676d84)}@media(max-width:600px){.ds-upload{min-height:190px;padding:22px 18px}}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-ghost,.ds-kpi,.ds-appearance,.ds-upload{transition:none;animation:none}}"
    },
    {
      "name": "Заголовок и наведение SKU",
      "kind": "custom",
      "description": "Последняя коррекция специфичности в приложении: заголовок и hovered td используют surface-2 в обеих темах.",
      "html": "<table class=\"ds-sku\"><thead><tr><th>Артикул</th><th>Продажи</th></tr></thead><tbody><tr><td>Артикул</td><td>—</td></tr></tbody></table>",
      "css": ".ds-sku{font-family:var(--font-sans,Manrope,system-ui,sans-serif);font-size:13px;width:100%;border-collapse:collapse;background:var(--surface,#fff);color:var(--ink,#161b30)}.ds-sku th{padding:10px 14px;background:var(--surface-2,#f2f4f7);color:var(--ink-soft,#4b5168);font-size:11px;font-weight:650;letter-spacing:.025em;border-bottom:1px solid var(--line,#161b3017);backdrop-filter:none}.ds-sku td{padding:10px 14px;border-bottom:1px solid var(--line,#161b3017);background:transparent}.ds-sku tbody tr:hover,.ds-sku tbody tr:hover td{background:var(--surface-2,#f2f4f7)}"
    }
  ],
