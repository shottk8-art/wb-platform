# Заголовки для Netlify: этот файл он читает сам, если тот лежит в папке сайта.

# Сервис-воркер браузер обязан перепроверять при каждом открытии —
# иначе обновление офлайн-режима может застрять на старой версии.
/sw.js
  Cache-Control: no-cache

# Правильный тип для манифеста: по нему браузер узнаёт, что сайт можно установить.
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
